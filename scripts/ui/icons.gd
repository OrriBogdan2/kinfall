class_name Icons
## Small vector icons for abilities, weapons and items, drawn straight onto a Control so they stay
## crisp at any size. Coordinates are in a -1..1 box around the centre.

static func draw(c: Control, id: String, at: Vector2, s: float, col: Color) -> void:
	var w := maxf(2.0, s * 0.16)
	var P := func(x: float, y: float) -> Vector2: return at + Vector2(x, y) * s
	var L := func(pts: Array, width := -1.0) -> void:
		var arr := PackedVector2Array()
		for q in pts: arr.append(P.call(q[0], q[1]))
		c.draw_polyline(arr, col, w if width < 0.0 else width, true)
	var F := func(pts: Array, cc := col) -> void:
		var arr := PackedVector2Array()
		for q in pts: arr.append(P.call(q[0], q[1]))
		c.draw_colored_polygon(arr, cc)
	var A := func(x: float, y: float, r: float, a0: float, a1: float, width := -1.0) -> void:
		c.draw_arc(P.call(x, y), r * s, a0, a1, 24, col, w if width < 0.0 else width, true)
	var O := func(x: float, y: float, r: float, cc := col) -> void:
		c.draw_circle(P.call(x, y), r * s, cc)
	match id:
		# ---- movement and items
		"dash":
			L.call([[-0.7, -0.6], [-0.1, 0.0], [-0.7, 0.6]]); L.call([[0.0, -0.6], [0.6, 0.0], [0.0, 0.6]])
		"jump":
			L.call([[-0.6, 0.2], [0.0, -0.5], [0.6, 0.2]]); L.call([[0.0, -0.5], [0.0, 0.7]])
		"tonic":
			F.call([[-0.5, -0.05], [0.5, -0.05], [0.6, 0.55], [0.3, 0.8], [-0.3, 0.8], [-0.6, 0.55]])
			L.call([[-0.2, -0.75], [-0.2, -0.05]]); L.call([[0.2, -0.75], [0.2, -0.05]]); L.call([[-0.35, -0.75], [0.35, -0.75]])
		"throw":
			O.call(0.0, 0.2, 0.5)
			F.call([[-0.45, -0.1], [-0.3, -0.75], [-0.05, -0.25]]); F.call([[0.45, -0.1], [0.3, -0.75], [0.05, -0.25]])
			O.call(-0.17, 0.12, 0.08, Color(0, 0, 0, 0.7)); O.call(0.17, 0.12, 0.08, Color(0, 0, 0, 0.7))
		"recall":
			A.call(0.0, 0.0, 0.6, -PI * 0.2, PI * 1.4)
			F.call([[0.55, -0.55], [0.8, -0.05], [0.25, -0.1]])
		# ---- weapons
		"stinger":
			F.call([[-0.8, -0.2], [0.6, -0.2], [0.6, 0.05], [-0.1, 0.05], [-0.25, 0.6], [-0.5, 0.6], [-0.4, 0.05], [-0.8, 0.05]])
		"repeater":
			F.call([[-0.9, -0.15], [0.85, -0.15], [0.85, 0.05], [-0.2, 0.05], [-0.35, 0.5], [-0.6, 0.5], [-0.5, 0.05], [-0.9, 0.05]])
		"rail":
			F.call([[-0.9, -0.1], [0.9, -0.1], [0.9, 0.08], [-0.9, 0.08]])
			L.call([[-0.4, -0.3], [0.6, -0.3]], maxf(1.5, s * 0.08)); F.call([[-0.6, 0.08], [-0.4, 0.08], [-0.5, 0.5], [-0.7, 0.5]])
		"rocket", "thumper":
			F.call([[-0.85, -0.3], [0.6, -0.3], [0.6, 0.3], [-0.85, 0.3]])
			F.call([[0.6, -0.4], [0.9, -0.4], [0.9, 0.4], [0.6, 0.4]]); F.call([[-0.3, 0.3], [-0.05, 0.3], [-0.15, 0.7], [-0.4, 0.7]])
		# ---- E abilities
		"cloak":
			A.call(0.0, 0.25, 0.75, PI * 1.15, PI * 1.85); A.call(0.0, -0.25, 0.75, PI * 0.15, PI * 0.85)
			O.call(0.0, 0.0, 0.22)
		"mend":
			F.call([[-0.2, -0.75], [0.2, -0.75], [0.2, -0.2], [0.75, -0.2], [0.75, 0.2], [0.2, 0.2], [0.2, 0.75], [-0.2, 0.75], [-0.2, 0.2], [-0.75, 0.2], [-0.75, -0.2], [-0.2, -0.2]])
		"fortify", "bulwark":
			F.call([[0.0, -0.8], [0.7, -0.5], [0.6, 0.25], [0.0, 0.8], [-0.6, 0.25], [-0.7, -0.5]])
			if id == "bulwark":
				F.call([[0.0, -0.45], [0.38, -0.28], [0.32, 0.12], [0.0, 0.45], [-0.32, 0.12], [-0.38, -0.28]], Color(0, 0, 0, 0.45))
		"blink":
			L.call([[-0.8, 0.5], [-0.2, -0.1], [0.1, 0.3], [0.7, -0.4]])
			F.call([[0.8, -0.6], [0.75, -0.1], [0.35, -0.45]])
			O.call(-0.8, 0.5, 0.12)
		"tether":
			L.call([[-0.75, 0.6], [0.45, -0.45]])
			F.call([[0.75, -0.75], [0.25, -0.6], [0.6, -0.25]])
			A.call(-0.55, 0.45, 0.25, 0, TAU)
		"hook":
			L.call([[0.4, -0.8], [0.4, 0.2]])
			A.call(0.05, 0.2, 0.35, 0.0, PI)
			F.call([[-0.3, 0.2], [-0.45, -0.15], [-0.15, -0.05]])
		"rocketjump":
			L.call([[0.0, 0.5], [0.0, -0.6]]); L.call([[-0.45, -0.15], [0.0, -0.65], [0.45, -0.15]])
			A.call(0.0, 0.7, 0.45, PI, TAU)
		"ram":
			L.call([[-0.8, -0.55], [-0.3, 0.0], [-0.8, 0.55]]); L.call([[-0.2, -0.55], [0.3, 0.0], [-0.2, 0.55]])
			F.call([[0.4, -0.6], [0.85, 0.0], [0.4, 0.6]])
		"dome", "sanctuary", "well":
			A.call(0.0, 0.45, 0.75, PI, TAU)
			L.call([[-0.85, 0.45], [0.85, 0.45]])
			if id == "sanctuary":
				L.call([[0.0, -0.1], [0.0, 0.35]]); L.call([[-0.22, 0.12], [0.22, 0.12]])
			if id == "well":
				A.call(0.0, 0.2, 0.25, 0, TAU * 0.8)
		# ---- ultimates
		"vanish":
			for i in 3:
				var x := -0.5 + i * 0.5
				A.call(x, 0.0, 0.18 + i * 0.05, 0, TAU, maxf(1.5, s * 0.08))
		"dance":
			for i in 3:
				var o := -0.45 + i * 0.45
				L.call([[o - 0.3, 0.7], [o + 0.3, -0.7]])
		"skypierce":
			F.call([[-0.85, -0.12], [0.6, -0.12], [0.6, 0.12], [-0.85, 0.12]])
			F.call([[0.55, -0.35], [0.9, 0.0], [0.55, 0.35]])
			L.call([[-0.5, -0.45], [0.3, -0.45]], maxf(1.5, s * 0.07)); L.call([[-0.5, 0.45], [0.3, 0.45]], maxf(1.5, s * 0.07))
		"anchor":
			L.call([[0.0, -0.75], [0.0, 0.6]])
			A.call(0.0, 0.1, 0.6, PI * 0.15, PI * 0.85)
			L.call([[-0.3, -0.45], [0.3, -0.45]])
			A.call(0.0, -0.75, 0.15, 0, TAU)
		"barrage":
			for q in [[-0.45, 0.35], [0.0, -0.1], [0.45, 0.35]]:
				O.call(q[0], q[1], 0.2)
				L.call([[q[0], q[1] - 0.25], [q[0] - 0.15, q[1] - 0.65]], maxf(1.5, s * 0.07))
		"quake":
			L.call([[-0.8, 0.6], [-0.3, 0.1], [0.0, 0.4], [0.35, -0.2], [0.8, -0.6]])
			L.call([[-0.3, 0.1], [-0.4, -0.4]]); L.call([[0.35, -0.2], [0.55, 0.3]])
		# ---- kin skills
		"fireball":
			O.call(0.25, -0.2, 0.42)
			F.call([[-0.05, -0.45], [-0.85, 0.65], [0.0, 0.05]])
		"wave":
			for i in 2:
				var y := -0.3 + i * 0.55
				A.call(-0.4, y, 0.35, PI, TAU); A.call(0.3, y, 0.35, 0, PI)
		"snare":
			A.call(0.0, 0.0, 0.65, 0, TAU)
			L.call([[-0.45, -0.45], [0.45, 0.45]]); L.call([[0.45, -0.45], [-0.45, 0.45]])
		"chain":
			F.call([[0.15, -0.85], [-0.5, 0.1], [-0.05, 0.1], [-0.2, 0.85], [0.5, -0.15], [0.05, -0.15]])
		"slam":
			F.call([[-0.4, -0.7], [0.4, -0.7], [0.4, 0.0], [0.7, 0.0], [0.0, 0.6], [-0.7, 0.0], [-0.4, 0.0]])
			L.call([[-0.85, 0.8], [0.85, 0.8]])
		"gust":
			A.call(0.0, 0.0, 0.65, -PI * 0.5, PI * 1.0)
			A.call(0.0, 0.0, 0.35, PI * 0.5, PI * 2.0)
			O.call(0.0, 0.0, 0.1)
		# ---- right-click secondaries
		"shadowstep":
			L.call([[-0.7, 0.7], [0.3, -0.3]]); F.call([[0.55, -0.55], [0.15, -0.45], [0.45, -0.15]])
			O.call(0.6, 0.5, 0.2)
		"bolas":
			O.call(-0.5, 0.4, 0.22); O.call(0.5, 0.4, 0.22); O.call(0.0, -0.5, 0.22)
			L.call([[-0.5, 0.4], [0.0, -0.1], [0.5, 0.4]]); L.call([[0.0, -0.1], [0.0, -0.5]])
		"divehawk":
			F.call([[0.0, 0.8], [-0.25, 0.1], [-0.85, -0.45], [-0.1, -0.2], [0.0, -0.7], [0.1, -0.2], [0.85, -0.45], [0.25, 0.1]])
		"breeze":
			A.call(-0.1, 0.0, 0.55, -PI * 0.9, PI * 0.4)
			L.call([[-0.85, 0.55], [0.4, 0.55]]); L.call([[0.25, -0.2], [0.25, 0.25]]); L.call([[0.02, 0.02], [0.48, 0.02]])
		"haymaker":
			F.call([[-0.55, -0.45], [0.35, -0.45], [0.55, -0.2], [0.55, 0.35], [0.35, 0.6], [-0.55, 0.6]])
			L.call([[-0.6, 0.05], [-0.95, 0.05]]); L.call([[-0.6, 0.35], [-0.95, 0.45]])
		"satchel":
			F.call([[-0.6, -0.3], [0.6, -0.3], [0.6, 0.6], [-0.6, 0.6]])
			A.call(0.0, -0.3, 0.3, PI, TAU); L.call([[0.35, -0.5], [0.65, -0.85]]); O.call(0.7, -0.88, 0.1, Color("fff27a"))
		"brightshield":
			A.call(0.0, 0.6, 0.85, PI * 1.2, PI * 1.8, maxf(2.5, s * 0.22))
			L.call([[0.0, 0.7], [0.0, 0.2]])
		"cleave":
			A.call(0.0, 0.3, 0.75, PI * 1.05, PI * 1.95)
			F.call([[-0.15, 0.85], [0.15, 0.85], [0.15, -0.1], [-0.15, -0.1]])
		"binding":
			O.call(0.0, 0.0, 0.3)
			for i in 4:
				var a := TAU * i / 4.0 + 0.4
				L.call([[cos(a) * 0.45, sin(a) * 0.45], [cos(a) * 0.85, sin(a) * 0.85]])
		_:
			O.call(0.0, 0.0, 0.4)
