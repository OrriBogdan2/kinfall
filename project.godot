; Engine configuration file.
config_version=5

[application]
config/name="Kinfall"
config/description="Raise kin on your farm, then take them into PvPvE extraction matches."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=0
boot_splash/bg_color=Color(0.02, 0.015, 0.035, 1)
boot_splash/image="res://art/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
boot_splash/show_image=true
boot_splash/minimum_display_time=0

[autoload]
Data="*res://scripts/core/data.gd"
Save="*res://scripts/core/save.gd"
Sfx="*res://scripts/core/sfx.gd"
Settings="*res://scripts/core/settings.gd"
Bridge="*res://scripts/core/bridge.gd"
Game="*res://scripts/core/game.gd"
Net="*res://scripts/core/net.gd"
Social="*res://scripts/core/social.gd"
Overlay="*res://scripts/ui/overlay.gd"
Shot="*res://scripts/shot.gd"
CombatBus="*res://scripts/combat/combat_bus.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

[gui]
theme/custom_font="res://fonts/Rubik.ttf"

[shader_globals]

vis_on={
"type": "float",
"value": 0.0
}
vis_focus={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
vis_dir={
"type": "vec2",
"value": Vector2(0, -1)
}
vis_size={
"type": "vec2",
"value": Vector2(1, 1)
}
vis_blocks={
"type": "sampler2D",
"value": ""
}

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=2
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
